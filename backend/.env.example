RIPPLE_ENVIRONMENT=development

# Comma-separated browser origins allowed to call the API.
RIPPLE_CORS_ORIGINS=http://localhost:3000

# Demo safety: set to true to serve seed/fixtures.json instead of Supabase.
RIPPLE_OFFLINE=false

# Supabase (Phase 1). Service key is server-side only — never expose to the browser.
RIPPLE_SUPABASE_URL=
RIPPLE_SUPABASE_SERVICE_KEY=

# Solver time caps (seconds). Keep these; they stop the UI from hanging.
RIPPLE_SOLVER_PLAN_TIMEOUT=10.0
RIPPLE_SOLVER_REPAIR_TIMEOUT=3.0
RIPPLE_SOLVER_SCENARIO_TIMEOUT=0.5

# Monte-Carlo stress test (Phase 5). Fixed seed keeps the Ripple Score reproducible.
RIPPLE_STRESS_SCENARIOS=200
RIPPLE_STRESS_SEED=20260810
